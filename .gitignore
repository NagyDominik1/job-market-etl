# Secrets / local config
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Raw API responses (can be large and are re-downloadable)
data/raw/

# Local Claude Code settings
.claude/settings.local.json

# My real manual job lists stay local; only the format description is committed.
# (An example file is in data/examples/.)
data/manual/*
!data/manual/README.md

# My real job-search profile stays local; config/profile.example.yaml is committed.
config/profile.yaml

# Connection settings for the Supabase database (DATABASE_URL etc.): a secret.
.env.supabase

# The filled-in search_profile SQL (my real profile); the template is committed.
sql/search_profile_local.sql

# The filled-in letter templates (my real skills); the template is committed.
sql/letter_templates_local.sql
