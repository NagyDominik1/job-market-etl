# Copy this file to .env and fill in your own values:
#   cp .env.example .env
POSTGRES_DB=job_market
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
# Where the Python code connects to (the Docker container publishes port 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Sources to run, comma-separated, in this order. Known: arbeitnow, csv
SOURCES=arbeitnow,csv
# Arbeitnow API: maximum number of pages per run (3 pages = several hundred jobs)
ARBEITNOW_MAX_PAGES=3
# Folder with the manual CSV files (default: data/manual)
# CSV_DIR=data/manual

# AI enrichment (optional; not run until Phase 3). Leave the key empty to use rules.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Maximum number of jobs sent to Claude per pipeline run (cost control)
ENRICH_LIMIT=20
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
