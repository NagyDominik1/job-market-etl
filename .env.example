# Copy this file to .env and fill in your own values:
#   cp .env.example .env
POSTGRES_DB=job_market
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
# Where the Python code connects to (the Docker container publishes port 5432).
# 127.0.0.1, not "localhost": Postgres listens on IPv4 127.0.0.1 only, and on
# Windows "localhost" tries IPv6 (::1) first and waits 10 s for it to time out.
POSTGRES_HOST=127.0.0.1

# A managed database (Supabase) is configured with DATABASE_URL instead, in the
# separate, gitignored file .env.supabase (see README "Running against Supabase").
# DATABASE_URL takes precedence over the POSTGRES_* values above; don't set it here.
POSTGRES_PORT=5432

# Sources to run, comma-separated, in this order. Known: arbeitnow, csv
SOURCES=arbeitnow,csv
# Arbeitnow API: maximum number of pages per run (3 pages = several hundred jobs)
ARBEITNOW_MAX_PAGES=3
# Folder with the manual CSV files (default: data/manual)
# CSV_DIR=data/manual

# AI enrichment (optional; not run until Phase 3). Leave the key empty to use rules.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Maximum number of jobs sent to Claude per pipeline run (cost control)
ENRICH_LIMIT=20
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
