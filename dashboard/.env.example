# Copy to .env.local (gitignored) and fill in from Supabase:
#   Project Settings -> API (or the "Connect" button -> App Frameworks)
# The anon / publishable key is PUBLIC by design: it ends up in the browser anyway.
# The data is protected by Row Level Security (migration 005), not by this key.
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon or publishable key>
